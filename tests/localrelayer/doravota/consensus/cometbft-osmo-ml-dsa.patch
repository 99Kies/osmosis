+++ b/crypto/mldsa65/pubkey.go
@@ -0,0 +1,40 @@
+// Package mldsa65 implements verification of remote CometBFT 0.40 commits.
+// It exposes no private key or local validator configuration.
+package mldsa65
+
+import (
+	"bytes"
+	"fmt"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa65"
+	"github.com/cometbft/cometbft/crypto"
+	"github.com/cometbft/cometbft/crypto/tmhash"
+)
+
+const SignatureSize = mldsa65.SignatureSize
+
+type PubKey struct{ key [mldsa65.PublicKeySize]byte }
+
+func NewPubKey(packed []byte) (crypto.PubKey, error) {
+	if len(packed) != mldsa65.PublicKeySize {
+		return nil, fmt.Errorf("invalid ML-DSA-65 public key size: %d", len(packed))
+	}
+	var key PubKey
+	copy(key.key[:], packed)
+	return key, nil
+}
+
+func (k PubKey) Bytes() []byte           { return k.key[:] }
+func (k PubKey) Address() crypto.Address { return crypto.Address(tmhash.SumTruncated(k.key[:])) }
+func (PubKey) Type() string              { return "ml_dsa_65" }
+func (k PubKey) Equals(other crypto.PubKey) bool {
+	o, ok := other.(PubKey)
+	return ok && bytes.Equal(k.key[:], o.key[:])
+}
+func (k PubKey) VerifySignature(msg, sig []byte) bool {
+	if len(sig) != SignatureSize {
+		return false
+	}
+	var decoded mldsa65.PublicKey
+	return decoded.UnmarshalBinary(k.key[:]) == nil && mldsa65.Verify(&decoded, msg, nil, sig)
+}
